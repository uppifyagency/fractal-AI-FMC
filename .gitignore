# Minimal gitignore — explicitly per user request "include tutto"
# Only excludes OS noise that has zero project value.
.DS_Store
Thumbs.db

# Claude Code runtime state (per-session locks, scheduled task state)
.claude/

# Secrets — NEVER commit (overrides "include tutto"; real secrets live in the
# macOS Keychain, see work/12_conjecture_e/E1_LLM_DESIGN.md)
.env
.env.*
*.key
secrets.*

# Vendored dependency repos — they carry their own .git history and cannot be
# committed as plain content (git would add a dangling gitlink). Cloned per the
# repos/ table in CLAUDE.md; re-clone from upstream rather than tracking here.
repos/flogging/
repos/hydraclick/
repos/kdense-scientific-skills/
repos/plangym/
repos/science-skills/
repos/shaolin/

# Python build / cache
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/

# fmc-core editable install artifacts
fmc-core/build/
fmc-core/dist/
fmc-core/src/*.egg-info/

# Cross-language test fixture (regenerated by tests)
fmc-core/tests/_fixture_relativize.json

# SUMO scenario artifacts (regenerated per run)
fmc-core/bench/sumo/scenarios/*/routes.rou.xml
fmc-core/bench/sumo/scenarios/*/trips_*.xml
fmc-core/bench/sumo/scenarios/*/stats_*.xml
# nWave activation marker (keep .nwave/local-config.json trackable)
.nwave/*
!.nwave/local-config.json
