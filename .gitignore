# Minimal gitignore — explicitly per user request "include tutto"
# Only excludes OS noise that has zero project value.
.DS_Store
Thumbs.db

# Claude Code runtime state (per-session locks, scheduled task state)
.claude/

# Python build / cache
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/

# fmc-core editable install artifacts
fmc-core/build/
fmc-core/dist/
fmc-core/src/*.egg-info/

# Cross-language test fixture (regenerated by tests)
fmc-core/tests/_fixture_relativize.json
